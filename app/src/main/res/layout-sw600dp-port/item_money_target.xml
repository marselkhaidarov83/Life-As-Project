<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/materialCardViewTarget"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    android:layout_marginBottom="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/linearLayoutMoneyTargetItem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="7dp"
            android:layout_marginBottom="5dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="50"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewName"
                    style="@style/MoneyTargetRViewItem.TextViewLeft"
                    android:text="TextView" />

                <TextView
                    android:id="@+id/textViewDate"
                    style="@style/MoneyTargetRViewItem.TextViewLeft"
                    android:text="TextView" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="50"
                android:orientation="vertical"
                android:paddingStart="5dp"
                android:paddingEnd="0dp">

                <TextView
                    android:id="@+id/textViewPriceLabel"
                    style="@style/MoneyTargetRViewItem.TextViewRight"
                    android:text="@string/Price" />

                <TextView
                    android:id="@+id/textViewAccumulationLabel"
                    style="@style/MoneyTargetRViewItem.TextViewRight"
                    android:text="@string/Accumulation" />

                <TextView
                    android:id="@+id/textViewCreditLabel"
                    style="@style/MoneyTargetRViewItem.TextViewRight"
                    android:text="@string/Credit" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="53"
                android:orientation="vertical">

                    <TextView
                        android:id="@+id/textViewPrice"
                        style="@style/MoneyTargetRViewItem.TextViewLeft"
                        android:text="TextView" />

                    <TextView
                        android:id="@+id/textViewAccumulation"
                        style="@style/MoneyTargetRViewItem.TextViewLeft"
                        android:text="TextView" />

                    <TextView
                        android:id="@+id/textViewCredit"
                        style="@style/MoneyTargetRViewItem.TextViewLeft"
                        android:text="TextView" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_weight="47">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.MH83.LifeAsProject.custom.CustomImageViewH
                        android:id="@+id/imageViewImage"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical|end"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_launcher_background" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/MoneyTarget.Item.ImageViewStatus.Width"
            android:layout_height="@dimen/MoneyTarget.Item.ImageViewStatus.Width"
            android:layout_marginStart="@dimen/BasePadding"
            android:layout_marginTop="@dimen/BasePadding">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <ImageView
                    android:id="@+id/imageViewStatus"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@color/white">

                </ImageView>

                <TextView
                    android:id="@+id/textViewStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="88"
                    android:textAlignment="center"
                    android:textSize="16sp" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>