<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginStart="@dimen/BasePadding"
    android:layout_marginTop="@dimen/BasePadding"
    android:layout_marginEnd="@dimen/BasePadding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_weight="30"
            android:paddingStart="@dimen/BasePadding"
            android:paddingEnd="@dimen/BasePadding"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/textViewName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_weight="1"
                android:text="@string/CustomString"
                style="@style/MoneyTargetRViewItem.TextView" />

            <TextView
                android:id="@+id/textViewValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:layout_gravity="center_vertical|end"
                android:layout_weight="10"
                android:text="@string/CustomString"
                style="@style/MoneyTargetRViewItem.TextView" />

            <TextView
                android:id="@+id/textViewMeasure"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/HalfPadding"
                android:textAlignment="center"
                android:layout_gravity="center_vertical|center"
                android:text="+"
                style="@style/MoneyTargetRViewItem.TextView" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_weight="50"
            android:paddingStart="@dimen/BasePadding"
            android:paddingEnd="@dimen/BasePadding"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/textViewType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="textStart"
                android:layout_gravity="center_vertical|start"
                android:layout_weight="1"
                android:text="@string/CustomString"
                style="@style/MoneyTargetRViewItem.TextView" />

            <TextView
                android:id="@+id/textViewKoef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:layout_gravity="center_vertical|end"
                android:layout_weight="10"
                android:text="@string/CustomString"
                style="@style/MoneyTargetRViewItem.TextView" />

            <TextView
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/HalfPadding"
                android:textAlignment="center"
                android:layout_gravity="center_vertical|center"
                style="@style/MoneyTargetRViewItem.TextView" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>