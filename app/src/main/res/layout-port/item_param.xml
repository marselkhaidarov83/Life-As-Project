<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/materialCardViewParam"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginStart="3dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/BasePadding"
        android:layout_marginBottom="@dimen/BasePadding"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/textViewName"
                style="@style/ParamRViewItem"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:minLines="1"
                android:singleLine="true"
                android:text="@string/CustomString"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewMeasure"
                style="@style/ParamRViewItem"
                android:layout_width="match_parent"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical|end"
                android:maxLines="1"
                android:minLines="1"
                android:singleLine="true"
                android:text="@string/CustomString"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/textViewName"
                app:layout_constraintTop_toTopOf="parent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/textViewComment"
                style="@style/ParamRViewItem"
                android:layout_width="match_parent"
                android:layout_weight="5"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:minLines="1"
                android:singleLine="false"
                android:text="@string/CustomString"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/textViewMeasure"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>