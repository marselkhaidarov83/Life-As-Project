<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="640dp"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaption"
        style="@style/Popup.ConstraintLayout.Caption">

        <ImageView
            android:id="@+id/imageViewDelete"
            style="@style/Popup.ImageView.Delete"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Popup.TextView.Caption"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/PopupDreamAdd"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/Popup.ImageView.Close"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:layout_margin="@dimen/BasePadding2">

                <TableRow
                    android:id="@+id/MoneyIncreasePopup1row"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView3"
                        style="@style/MoneyIncreasePopup1Column"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prevValueOn"
                        android:textAlignment="textEnd" />

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/textViewDatePrev"
                        style="@style/MoneyIncreasePopup3Column"
                        android:layout_height="wrap_content"
                        android:text="февраль 1999" />

                    <TextView
                        android:id="@+id/textView9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/textViewPrevValue"
                        style="@style/MoneyIncreasePopup5Column"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500000" />
                </TableRow>

                <TableRow
                    android:id="@+id/MoneyIncreasePopup2row"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView5"
                        style="@style/MoneyIncreasePopup1Column"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/planIncreaseValue" />

                    <ImageView
                        android:id="@+id/imageViewDateBack"
                        style="@style/MoneyIncreasePopup2Column"
                        android:clickable="true"
                        android:src="@drawable/icons_double_left_96" />

                    <TextView
                        android:id="@+id/textViewDate"
                        style="@style/MoneyIncreasePopup3Column"
                        android:layout_height="wrap_content"
                        android:background="@color/lightGrey"
                        android:text="февраль 2000" />

                    <ImageView
                        android:id="@+id/imageViewDateForward"
                        style="@style/MoneyIncreasePopup4Column"
                        android:clickable="true"
                        android:src="@drawable/icons_double_right_96" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <EditText
                            android:id="@+id/editTextValue"
                            style="@style/MoneyIncreasePopup5ColumnValue"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginTop="5dp"
                            android:background="@color/lightGrey"
                            android:ems="6"
                            android:inputType="numberDecimal"
                            android:text="1000000" />

                        <ImageView
                            android:id="@+id/imageViewArchive"
                            style="@style/Popup.ImageView.Archive"
                            android:src="@drawable/icons_nonarchive"
                            android:layout_gravity="center_vertical" />

                    </LinearLayout>

                </TableRow>

                <TableRow
                    android:id="@+id/MoneyIncreasePopup3row"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView6"
                        style="@style/MoneyIncreasePopup1Column"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nextValueOn" />

                    <TextView
                        android:id="@+id/textView10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/textViewDateNext"
                        style="@style/MoneyIncreasePopup3Column"
                        android:layout_height="wrap_content"
                        android:text="декабрь 2024" />

                    <TextView
                        android:id="@+id/textView11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/textViewNextValue"
                        style="@style/MoneyIncreasePopup5Column"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2000000" />
                </TableRow>
            </TableLayout>

            <Button
                android:id="@+id/buttonSave"
                style="@style/Popup.Button.Save"
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/BasePadding2"
                android:layout_marginEnd="@dimen/BasePadding2"
                android:layout_marginBottom="@dimen/BasePadding">

            </Button>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
