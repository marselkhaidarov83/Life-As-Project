<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageView
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/imageViewPhoto"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/icons_foto_purple_100">

                    </ImageView>

                    <EditText
                        android:id="@+id/editTextName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/imageViewPhoto"
                        android:textSize="18sp"
                        android:inputType="text"
                        android:autofillHints="false"
                        android:text="@string/CustomString" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="40dp">

                    <ImageView
                        android:id="@+id/imageViewDateBack"
                        style="@style/MoneyTargetPopup2Column"
                        android:layout_marginStart="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:src="@drawable/icons_double_left_96" />

                    <ImageView
                        android:id="@+id/imageViewDateForward"
                        style="@style/MoneyTargetPopup4Column"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:src="@drawable/icons_double_right_96" />

                    <TextView
                        android:id="@+id/textViewDate"
                        style="@style/MoneyTargetPopup3Column"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imageViewDateBack"
                        app:layout_constraintEnd_toStartOf="@id/imageViewDateForward"
                        android:background="@color/lightGrey"
                        android:text="@string/CustomDate" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="@dimen/BasePadding">

                <TextView
                    android:id="@+id/textViewStatus"
                    style="@style/MoneyTargetPopup.TextView"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:textSize="18sp"
                    android:labelFor="@id/editTextPrice"
                    android:text="@string/TargetStatus"
                    android:textAlignment="textEnd" />

                <Spinner
                    android:id="@+id/spinnerStatus"
                    style="@style/MoneyCategoryPopup.EditText"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/BasePadding">

                </Spinner>

            </TableRow>

        </TableLayout>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TableRow
                android:id="@+id/MoneyTargetPopup1row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textViewPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/MoneyTargetPopup.TextView"
                    android:text="@string/Price"
                    android:textAlignment="textEnd"
                    android:labelFor="@id/editTextPrice"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/editTextPrice"
                    style="@style/MoneyTargetPopup.EditText"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="">
                </EditText>

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent" >

                <TextView
                    style="@style/MoneyTargetPopup.TextView"
                    android:text="@string/Accumulation"
                    android:textAlignment="textEnd"
                    android:labelFor="@id/editTextAccumulation"
                    android:layout_marginEnd="10dp">
                </TextView>

                <EditText
                    android:id="@+id/editTextAccumulation"
                    android:layout_width="match_parent"
                    style="@style/MoneyTargetPopup.EditText"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:text="">
                </EditText>

            </TableRow>

            <TableRow>

                <TextView
                    android:text="@string/Credit"
                    style="@style/MoneyTargetPopup.TextView"
                    android:textAlignment="textEnd"
                    android:labelFor="@id/editTextCredit"
                    android:layout_marginEnd="10dp">
                </TextView>

                <EditText
                    android:id="@+id/editTextCredit"
                    style="@style/MoneyTargetPopup.EditText"
                    android:enabled="false"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:text="">
                </EditText>

            </TableRow>

        </TableLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardViewImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <com.MH83.LifeAsProject.custom.CustomSubsamplingScaleImageViewW
            android:id="@+id/subsamplingScaleImageView"
            android:layout_width="match_parent"
            android:layout_height="225dp">

        </com.MH83.LifeAsProject.custom.CustomSubsamplingScaleImageViewW>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>