<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainSettings" parent="Custom" />

    <style name="MainSettings.TextView" />

    <style name="MainSettings.TextView.Header">
        <item name="android:textSize">@dimen/Tasks.Popup.TextSize04</item>
        <item name="android:layout_marginStart">@dimen/BasePadding</item>
    </style>

    <style name="MainSettings.TextView.Left">
        <item name="android:textSize">@dimen/Tasks.Popup.TextSize03</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="MainSettings.TextView.Right">
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="MainSettings.TextView.Time">
        <item name="android:textSize">@dimen/Tasks.Popup.TextSize04</item>
        <item name="android:text">@string/CustomTime</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_height">@dimen/Tasks.Popup.TextView.Time.Height</item>
        <item name="android:layout_width">@dimen/Tasks.Popup.TextView.Time.Width</item>
    </style>


    <style name="MainSettings.ImageView" />

    <style name="MainSettings.ImageView.Left">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="MainSettings.ImageView.Right">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:src">@drawable/icons_right_small_purple</item>
    </style>

    <style name="MainSettings.ImageView.Time">
        <item name="android:layout_width">@dimen/Tasks.Popup.TextView.Time.Height</item>
        <item name="android:layout_height">@dimen/Tasks.Popup.TextView.Time.Height</item>
    </style>

    <style name="MainSettings.ImageView.Time.Minus">
        <item name="android:src">@drawable/icons_minus_48_red</item>
    </style>

    <style name="MainSettings.ImageView.Time.Plus">
        <item name="android:src">@drawable/icons_plus_48_green</item>
    </style>


</resources>