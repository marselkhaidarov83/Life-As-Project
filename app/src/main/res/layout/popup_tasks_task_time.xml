<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_background"
        android:padding="@dimen/BasePadding2">

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Tasks.Popup.TextView.Caption"
            android:text="@string/PopupTasksTaskUpdateTime"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/Tasks.Popup.ImageView.Close"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/BasePadding"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/Tasks.Popup.LinearLayout.Date.Height"
                android:layout_span="2"
                android:layout_weight="1"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="4">

                    <ImageView
                        android:id="@+id/imageViewClearDate"
                        style="@style/Tasks.Task.Popup.ImageView.ClearDate"
                        android:layout_centerVertical="true"
                        android:src="@drawable/icons_cleardate_100"
                        app:layout_constraintLeft_toLeftOf="parent" />

                    <TextView
                        android:id="@+id/textViewDate"
                        style="@style/Tasks.Task.Popup.TextView.Date"
                        android:layout_centerInParent="true"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:gravity="center_vertical" />

                    <ImageView
                        android:id="@+id/imageViewDateMinus"
                        style="@style/Tasks.Task.Popup.ImageView.Date.Minus"
                        android:layout_toStartOf="@id/textViewDate" />

                    <ImageView
                        android:id="@+id/imageViewDatePlus"
                        style="@style/Tasks.Task.Popup.ImageView.Date.Plus"
                        android:layout_toEndOf="@id/textViewDate" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="7">

                    <TextView
                        android:id="@+id/textViewTime"
                        style="@style/Tasks.Task.Popup.TextView.Time"
                        android:layout_centerInParent="true"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:gravity="center_vertical" />

                    <ImageView
                        android:id="@+id/imageViewTimeMinus"
                        style="@style/Tasks.Task.Popup.ImageView.Time.Minus"
                        android:layout_toStartOf="@id/textViewTime" />

                    <ImageView
                        android:id="@+id/imageViewTimePlus"
                        style="@style/Tasks.Task.Popup.ImageView.Time.Plus"
                        android:layout_toEndOf="@id/textViewTime" />


                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textViewDateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/Date"
                    style="@style/Tasks.Task.Popup.TextView.Date.Title" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayoutRepeat"
                    android:layout_marginEnd="@dimen/BasePadding"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imageViewRepeat"
                        style="@style/Tasks.Task.Popup.ImageView.PF.Repeat"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:src="@drawable/icons_is_plan_100"/>

                    <TextView
                        android:id="@+id/textViewRepeat"
                        style="@style/Tasks.Task.Popup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:labelFor="@id/spinnerTypeCredit"
                        android:layout_marginStart="10dp"
                        android:text="@string/Repeat"
                        android:gravity="center_vertical|end"
                        app:layout_constraintStart_toEndOf="@id/imageViewRepeat"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:textAlignment="textEnd" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <EditText
                        android:id="@+id/editTextRepeatPeriod"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        style="@style/Tasks.Task.Popup.EditText"
                        android:inputType="numberDecimal"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintLeft_toRightOf="@id/spinnerRepeatType"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:text="@string/CustomShortNum"
                        android:textAlignment="center" />

                    <Spinner
                        android:id="@+id/spinnerRepeatType"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/editTextRepeatPeriod"
                        tools:listitem="@layout/simple_spinner_repeattype_item">

                    </Spinner>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textViewTodayLabel"
                    style="@style/Tasks.Task.Popup.TextView.Today"
                    android:layout_weight="1"
                    android:text="@string/Tasks.Task.Popup.Today" />

                <TextView
                    android:id="@+id/textViewToday"
                    style="@style/Tasks.Task.Popup.TextView.Value"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutTomorrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textViewTomorrowLabel"
                    style="@style/Tasks.Task.Popup.TextView.Tomorrow"
                    android:layout_weight="1"
                    android:text="@string/Tasks.Task.Popup.Tomorrow" />

                <TextView
                    android:id="@+id/textViewTomorrow"
                    style="@style/Tasks.Task.Popup.TextView.Value"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutThisWeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textViewThisWeekLabel"
                    style="@style/Tasks.Task.Popup.TextView.ThisWeek"
                    android:layout_weight="1"
                    android:text="@string/Tasks.Task.Popup.ThisWeek" />

                <TextView
                    android:id="@+id/textViewThisWeek"
                    style="@style/Tasks.Task.Popup.TextView.Value"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutOnTheWeekend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textViewOnTheWeekendLabel"
                    style="@style/Tasks.Task.Popup.TextView.OnTheWeekend"
                    android:layout_weight="1"
                    android:text="@string/Tasks.Task.Popup.OnTheWeekend" />

                <TextView
                    android:id="@+id/textViewOnTheWeekend"
                    style="@style/Tasks.Task.Popup.TextView.Value"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutNextWeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textViewNextWeekLabel"
                    style="@style/Tasks.Task.Popup.TextView.NextWeek"
                    android:layout_weight="1"
                    android:text="@string/Tasks.Task.Popup.NextWeek" />

                <TextView
                    android:id="@+id/textViewNextWeek"
                    style="@style/Tasks.Task.Popup.TextView.Value"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutPostponeUntil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textViewPostponeUntilLabel"
                    style="@style/Tasks.Task.Popup.TextView.PostponeUntil"
                    android:layout_weight="1"
                    android:text="@string/Tasks.Task.Popup.PostponeUntil" />

                <TextView
                    android:id="@+id/textViewPostponeUntil"
                    style="@style/Tasks.Task.Popup.TextView.Value"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutWithoutTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textViewWithoutTimeLabel"
                    style="@style/Tasks.Task.Popup.TextView.WithoutTime"
                    android:layout_weight="1"
                    android:text="@string/Tasks.Task.Popup.WithoutTime" />

                <TextView
                    android:id="@+id/textViewWithoutTime"
                    style="@style/Tasks.Task.Popup.TextView.Blank"
                    android:layout_weight="1" />

            </LinearLayout>

            <Button
                android:id="@+id/buttonSave"
                style="@style/Tasks.Popup.Button.OK"
                android:layout_width="match_parent">

            </Button>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>