<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/materialCardViewTask"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    android:layout_marginBottom="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayoutTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:paddingEnd="@dimen/BasePadding"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageViewConfirmed"
            style="@style/Tasks.Task.RViewItem.ImageView.Confirmed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <RelativeLayout
            android:id="@+id/relativeLayoutType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toRightOf="@id/imageViewConfirmed"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/imageViewType"
                style="@style/Tasks.Task.RViewItem.ImageView.Type"/>

            <TextView
                android:id="@+id/textViewType"
                style="@style/Tasks.Project.RViewItem.TextView.Count"
                android:text="88" />

        </RelativeLayout>

        <TableLayout
            android:id="@+id/tableLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/BasePadding"
            android:layout_marginTop="@dimen/BasePadding"
            android:layout_marginBottom="@dimen/BasePadding"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/relativeLayoutType"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TableRow
                android:layout_marginBottom="@dimen/Padding2dp">

                <TextView
                    android:id="@+id/textViewName"
                    android:layout_weight="1"
                    android:layout_span="3"
                    style="@style/Tasks.Task.RViewItem.TextView.Name" />

            </TableRow>

            <TableRow>

                <TextView
                    android:id="@+id/textViewComment"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:layout_span="3"
                    style="@style/Tasks.Task.RViewItem.TextView.Comment" />

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/Padding2dp">

                <TextView
                    android:id="@+id/textViewDate"
                    style="@style/Tasks.Task.RViewItem.TextView.Date"
                    app:layout_constraintLeft_toRightOf="@id/imageViewType"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/imageViewRepeat"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/BasePadding"
                    android:src="@drawable/icons_repeat_100_orange"
                    android:layout_gravity="center_vertical" />

                <TextView
                    android:id="@+id/textViewPeriod"
                    style="@style/Tasks.Task.RViewItem.TextView.Period"
                    app:layout_constraintLeft_toRightOf="@id/imageViewRepeat"
                    app:layout_constraintTop_toTopOf="parent" />

            </TableRow>

        </TableLayout>

        <TextView
            android:id="@+id/textViewProjectName"
            android:layout_width="wrap_content"
            android:paddingEnd="@dimen/BasePadding"
            style="@style/Tasks.Task.RViewItem.TextView.ProjectName"
            app:layout_constraintEnd_toEndOf="@id/tableLayout"
            app:layout_constraintBottom_toBottomOf="@id/tableLayout"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>