<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Popup.LinearLayout.Main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaption"
        style="@style/Popup.ConstraintLayout.Caption">

        <ImageView
            android:id="@+id/imageViewDelete"
            style="@style/Popup.ImageView.Delete"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Popup.TextView.Caption"
            android:text="@string/PopupDreamAdd"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/Popup.ImageView.Close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewMascotToChange"
            style="@style/Popup.ImageView.Mascot"
            app:layout_constraintEnd_toStartOf="@id/imageViewClose"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        style="@style/Popup.NestedScrollView.Main">

        <LinearLayout
            style="@style/Popup.LinearLayout.TopHead">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/editTextNameLayout"
                style="@style/Popup.ConstraintLayout.1Line">

                <ImageView
                    android:id="@+id/imageViewSelectPhoto"
                    style="@style/Popup.ImageView.SelectPhoto"
                    android:layout_marginTop="@dimen/BasePadding"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/imageViewArchive"
                    style="@style/Popup.MoneyDream.ImageView.Archive"
                    app:layout_constraintEnd_toStartOf="@id/imageViewSelectPhoto"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/editTextName"
                    style="@style/Popup.MoneyDream.EditText.Text.DreamName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/imageViewArchive"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardViewImage"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/BasePadding"
                android:layout_marginEnd="@dimen/BasePadding"
                android:layout_gravity="center">

                <com.MH83.LifeAsProject.custom.CustomSubsamplingScaleImageViewH
                    android:id="@+id/subsamplingScaleImageView"
                    android:layout_width="0dp"
                    android:layout_height="350dp" />

            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/buttonSave"
                style="@style/Popup.Button.Save" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>