<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/MainLayout">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaption"
        style="@style/Popup.ConstraintLayout.Caption">

        <ImageView
            android:id="@+id/imageViewDelete"
            style="@style/Popup.ImageView.Delete"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Popup.TextView.Caption"
            android:text="@string/fragmentMoneyPlanPopupAddTitle"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/Popup.ImageView.Close"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewMascotToChange"
            style="@style/Popup.ImageView.Mascot"
            app:layout_constraintEnd_toStartOf="@id/imageViewClose"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        style="@style/Popup.NestedScrollView.Main">

        <LinearLayout
            style="@style/Popup.NestedScrollView.LinearLayout.Main">

            <TableLayout
                style="@style/Popup.TableLayout">

                <TableRow
                    style="@style/Popup.TableRow">

                    <TextView
                        style="@style/Popup.TextView"
                        android:text="@string/Category" />

                    <TextView
                        android:id="@+id/textViewCategory"
                        style="@style/Popup.TextView.Right"
                        android:text="@string/Category" />

                </TableRow>

                <TableRow
                    android:id="@+id/tableIncomingRow2"
                    style="@style/Popup.TableRow">

                    <TextView
                        android:id="@+id/textViewType"
                        style="@style/Popup.TextView"
                        android:text="@string/Type" />

                    <Spinner
                        android:id="@+id/spinnerType"
                        style="@style/Popup.Spinner.OneValue"
                        tools:listitem="@layout/simple_spinner_1v_item" />

                </TableRow>

                <TableRow
                    android:id="@+id/tableIncomingRow4"
                    style="@style/Popup.TableRow">

                    <TextView
                        android:id="@+id/textViewAccumulation"
                        style="@style/Popup.TextView"
                        android:text="@string/Accumulation" />

                    <Spinner
                        android:id="@+id/spinnerAccumulation"
                        style="@style/Popup.Spinner.OneValue"
                        tools:listitem="@layout/simple_spinner_1v_item" />

                </TableRow>

                <TableRow
                    android:id="@+id/tableIncomingRow5"
                    style="@style/Popup.TableRow">

                    <TextView
                        android:id="@+id/textViewCredit"
                        style="@style/Popup.TextView"
                        android:text="@string/FromCredit" />

                    <Spinner
                        android:id="@+id/spinnerCredit"
                        style="@style/Popup.Spinner.OneValue"
                        tools:listitem="@layout/simple_spinner_1v_item" />

                </TableRow>

                <TableRow
                    style="@style/Popup.TableRow"
                    android:layout_marginBottom="0dp">

                    <TextView
                        style="@style/Popup.TextView.ForNum"
                        android:text="@string/Sum" />

                    <EditText
                        android:id="@+id/editTextSum"
                        style="@style/Popup.EditText.Number.Amount" />

                </TableRow>

            </TableLayout>

            <Button
                android:id="@+id/buttonSave"
                style="@style/Popup.Button.Save" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>