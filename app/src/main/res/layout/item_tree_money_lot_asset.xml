<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/textViewName"
        style="@style/Tasks.Project.RViewItem.TextView.Name"
        android:textSize="@dimen/Tasks.Popup.TextSize03"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/BasePadding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/BasePadding"
        android:layout_weight="1">

        <TextView
            android:id="@+id/textViewSumStart"
            style="@style/Tasks.Project.RViewItem.TextView.Name"
            android:textSize="@dimen/Tasks.Popup.TextSize03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/BasePadding"
        android:layout_weight="1">

        <TextView
            android:id="@+id/textViewSumThisPeriodPlus"
            style="@style/Tasks.Project.RViewItem.TextView.Name"
            android:textSize="@dimen/Tasks.Popup.TextSize03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/BasePadding"
        android:layout_weight="1">

        <TextView
            android:id="@+id/textViewSumThisPeriodMinus"
            style="@style/Tasks.Project.RViewItem.TextView.Name"
            android:textSize="@dimen/Tasks.Popup.TextSize03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/BasePadding"
        android:layout_weight="1">

        <TextView
            android:id="@+id/textViewSumEnd"
            style="@style/Tasks.Project.RViewItem.TextView.Name"
            android:textSize="@dimen/Tasks.Popup.TextSize03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/BasePadding"
        android:layout_weight="1">

        <TextView
            android:id="@+id/textViewDifference"
            style="@style/Tasks.Project.RViewItem.TextView.Name"
            android:textSize="@dimen/Tasks.Popup.TextSize03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/BasePadding"
        android:layout_weight="1">

        <TextView
            android:id="@+id/textViewDifferenceTotal"
            style="@style/Tasks.Project.RViewItem.TextView.Name"
            android:textSize="@dimen/Tasks.Popup.TextSize03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>