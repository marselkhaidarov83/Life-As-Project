<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/materialCardViewMain"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginStart="@dimen/BasePadding"
    android:layout_marginTop="@dimen/BasePadding"
    android:layout_marginEnd="@dimen/BasePadding">

    <LinearLayout
        android:id="@+id/linearLayoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:paddingStart="0dp"
            android:paddingEnd="20dp"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/textViewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:paddingEnd="0dp"
                android:text="@string/CustomString"
                style="@style/MoneyIncreaseRViewItem.TextView" />

            <TextView
                android:id="@+id/textViewValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:layout_gravity="center_vertical|end"
                android:layout_weight="1"
                android:text="@string/CustomString"
                style="@style/MoneyIncreaseRViewItem.TextView" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:paddingStart="20dp"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/textViewSign"
                android:layout_width="15dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/HalfPadding"
                android:textAlignment="center"
                android:layout_gravity="center_vertical|center"
                android:text="+"
                style="@style/MoneyIncreaseRViewItem.TextView" />

            <TextView
                android:id="@+id/textViewProcent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="textStart"
                android:layout_gravity="center_vertical|start"
                android:layout_weight="10"
                android:text="@string/CustomString"
                style="@style/MoneyIncreaseRViewItem.TextView" />

            <ImageView
                android:id="@+id/imageViewIncrease"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginTop="@dimen/BasePadding"
                android:layout_marginEnd="@dimen/BasePadding"
                android:layout_marginBottom="@dimen/BasePadding"
                android:layout_weight="10"
                android:scaleType="fitEnd"
                android:src="@drawable/icons_top_right_150" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>