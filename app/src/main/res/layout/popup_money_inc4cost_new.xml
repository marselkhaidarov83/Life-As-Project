<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Popup.LinearLayout.Main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaption"
        style="@style/Popup.ConstraintLayout.Caption">

        <ImageView
            android:id="@+id/imageViewDelete"
            style="@style/Popup.ImageView.Delete"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Popup.TextView.Caption"
            android:text="@string/fragmentMoneyInc4CostPopupAddTitle"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/Popup.ImageView.Close"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewMascotToChange2"
            style="@style/Popup.ImageView.Mascot"
            app:layout_constraintEnd_toStartOf="@id/imageViewClose"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView1"
        style="@style/Popup.NestedScrollView.Main.Visible">

        <LinearLayout
            style="@style/Popup.NestedScrollView.LinearLayout.Main">

            <TableLayout
                style="@style/Accounting.Popup.TableLayout">

                <TableRow>

                    <EditText
                        android:id="@+id/editTextSum"
                        style="@style/Accounting.Popup.EditText.Sum" />

                </TableRow>

                <TableRow>

                    <TextView
                        style="@style/Accounting.Popup.EditText.UnderSum"
                        android:layout_marginEnd="0dp"/>

                </TableRow>

                <TableRow>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycleViewCategoryCost"
                        style="@style/Accounting.Popup.RecyclerView"
                        tools:listitem="@layout/item_graph_money_category" />

                </TableRow>

                <TableRow
                    style="@style/Accounting.Popup.TableLayout.TableRow">

                    <LinearLayout
                        android:id="@+id/linearLayoutCost"
                        style="@style/Accounting.Popup.TableLayout.TableRow.LinearLayout50V">

                        <TextView
                            android:id="@+id/textViewTypeCostCategory"
                            style="@style/Accounting.Popup.TextView.Category" />

                        <TextView
                            android:id="@+id/textViewNameCostCategory"
                            style="@style/Accounting.Popup.TextView.Category2" />

                        <ImageView
                            android:id="@+id/imageViewCostCategory"
                            style="@style/Accounting.Popup.ImageView.Category" />

                        <TextView
                            android:id="@+id/textViewSumCostCategory"
                            style="@style/Accounting.Popup.TextView.Category3" />

                    </LinearLayout>

                    <ImageView
                        style="@style/Accounting.Popup.ImageView.Arrow" />

                    <LinearLayout
                        style="@style/Accounting.Popup.TableLayout.TableRow.LinearLayout50V">

                        <TextView
                            android:id="@+id/textViewTypeIncreaseCategory"
                            style="@style/Accounting.Popup.TextView.Category" />

                        <TextView
                            android:id="@+id/textViewNameIncreaseCategory"
                            style="@style/Accounting.Popup.TextView.Category2" />

                        <ImageView
                            android:id="@+id/imageViewIncreaseCategory"
                            style="@style/Accounting.Popup.ImageView.Category" />

                        <TextView
                            android:id="@+id/textViewSumIncreaseCategory"
                            style="@style/Accounting.Popup.TextView.Category3" />

                    </LinearLayout>

                </TableRow>

                <TableRow>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycleViewCategoryIncrease"
                        style="@style/Accounting.Popup.RecyclerView"
                        tools:listitem="@layout/item_graph_money_category" />

                </TableRow>

                <TableRow
                    style="@style/Accounting.Popup.TableLayout.TableRow">

                    <RelativeLayout
                        android:id="@+id/relativeLayoutDate"
                        style="@style/Accounting.Popup.RelativeLayout.Date">

                        <TextView
                            android:id="@+id/textViewDate"
                            style="@style/Accounting.Popup.TextView.Date" />

                        <ImageView
                            android:id="@+id/imageViewDateMinus"
                            style="@style/Accounting.Popup.ImageView.Date.Minus"
                            android:layout_toStartOf="@id/textViewDate" />

                        <ImageView
                            android:id="@+id/imageViewDatePlus"
                            style="@style/Accounting.Popup.ImageView.Date.Plus"
                            android:layout_toEndOf="@id/textViewDate" />

                    </RelativeLayout>

                </TableRow>

                <TableRow>

                    <TextView
                        android:id="@+id/textViewDateTitle"
                        style="@style/Accounting.Popup.EditText.UnderDate" />

                </TableRow>

            </TableLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <Button
                    android:id="@+id/buttonSave"
                    style="@style/Popup.Button.Save" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>