<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Popup.LinearLayout.Main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaption"
        style="@style/Popup.ConstraintLayout.Caption">

        <ImageView
            android:id="@+id/imageViewDelete"
            style="@style/Popup.ImageView.Delete"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            style="@style/Popup.TextView.Caption"
            android:text="@string/JobWithCategorySelect"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/Popup.ImageView.Close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        style="@style/Popup.NestedScrollView.Main">

        <LinearLayout
            style="@style/Popup.LinearLayout.TopHead">

            <TextView
                android:id="@+id/textViewLegend"
                style="@style/Popup.TextView.Legend"
                android:text="
Выбор категории осуществляется в 1 этап.\n
Для выбора категории нажмите на 1 иконку из списка иконок.\n
\n
Если вы захотите повторно посмотреть легенду о том, как выбирать категории, нажмите кнопку [mascot] в правом верхнем углу окна.\n
\n
PS: вы всегда можете включить/отключить помощника в настройках программы - для этого выберите меню 'Настройки' через 3 точки в правом верхнем углу экрана.\n
\n
PPS: в бесплатной версии программы вы можете добавлять сколько угодно операций с деньгами в рамках текущего месяца.
                "/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>