<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Popup.Settings.LinearLayout.TopHead">

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/Popup.Settings.ConstraintLayout.Head">

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Popup.Settings.TextView.Caption"
            android:text="@string/SettingsMoneyIncoming"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/Popup.Settings.ImageView.Close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        style="@style/Popup.Settings.NestedScrollView.Main">

        <LinearLayout
            style="@style/Popup.Settings.LinearLayout.Main">

            <CheckBox
                android:id="@+id/checkBoxShowIncreasePercent"
                style="@style/Popup.Settings.CheckBox"
                android:text="@string/IncomingSettingsShowIncreasePercent" />

            <CheckBox
                android:id="@+id/checkBoxShowPercent"
                style="@style/Popup.Settings.CheckBox"
                android:text="@string/IncomingSettingsShowPercent" />

            <CheckBox
                android:id="@+id/checkBoxShowBlankData"
                style="@style/Popup.Settings.CheckBox"
                android:text="@string/IncomingSettingsShowBlankData" />

            <LinearLayout
                style="@style/Popup.Settings.LinearLayout.ForSpinner">

                <TextView
                    style="@style/Popup.Settings.TextView.ForSpinner"
                    android:text="@string/IncomingSettingsShowData" />

                <Spinner
                    android:id="@+id/spinnerPlanFact"
                    style="@style/Popup.Settings.Spinner"
                    tools:listitem="@layout/simple_spinner_sett_1v_item"/>

            </LinearLayout>

            <LinearLayout
                style="@style/Popup.Settings.LinearLayout.ForSpinner">

                <TextView
                    style="@style/Popup.Settings.TextView.ForSpinner"
                    android:text="@string/IncomingSettingsPeriodData" />

                <Spinner
                    android:id="@+id/spinnerPeriodData"
                    style="@style/Popup.Settings.Spinner"
                    tools:listitem="@layout/simple_spinner_sett_1v_item"/>

            </LinearLayout>

            <LinearLayout
                style="@style/Popup.Settings.LinearLayout.ForSpinner">

                <TextView
                    style="@style/Popup.Settings.TextView.ForSpinner"
                    android:text="@string/IncomingSettingsCategoryType" />

                <Spinner
                    android:id="@+id/spinnerCategoryType"
                    style="@style/Popup.Settings.Spinner"
                    tools:listitem="@layout/simple_spinner_sett_1v_item"/>

            </LinearLayout>

            <Button
                android:id="@+id/buttonSave"
                style="@style/Popup.Settings.Button.OK" />

        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

</LinearLayout>