<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaption"
        style="@style/Tasks.Project.Popup.Layout.Caption">

        <ImageView
            android:id="@+id/imageViewDelete"
            style="@style/Tasks.Project.Popup.ImageView.Delete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Tasks.Project.Popup.TextView.Caption"
            android:text="@string/PopupPortfolioAdd"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/Tasks.Project.Popup.ImageView.Close"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/BasePadding"
        android:layout_marginEnd="@dimen/BasePadding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:orientation="vertical">

            <TableLayout
                android:id="@+id/tableLayout"
                android:layout_width="match_parent"
                android:layout_height="305dp"
                android:padding="@dimen/BasePadding">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewParent"
                        style="@style/Tasks.Project.Popup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/Parent"
                        android:textAlignment="textEnd" />

                    <Spinner
                        android:id="@+id/spinnerParent"
                        style="@style/Tasks.Project.Popup.Spinner.ParentProject"
                        android:layout_weight="1"
                        tools:listitem="@layout/simple_spinner_tasks_project_item">
                    </Spinner>
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/textViewName"
                        style="@style/Tasks.Project.Popup.TextView"
                        android:layout_width="wrap_content"
                        android:labelFor="@id/editTextName"
                        android:gravity="center_vertical|end"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:text="@string/Name" />

                    <EditText
                        android:id="@+id/editTextName"
                        style="@style/Tasks.Project.Popup.EditText"
                        android:layout_weight="1" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewStatus"
                        style="@style/Tasks.Project.Popup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/Status"
                        android:textAlignment="textEnd" />

                    <Spinner
                        android:id="@+id/spinnerStatus"
                        style="@style/Tasks.Project.Popup.Spinner.Status"
                        android:layout_weight="1"
                        tools:listitem="@layout/simple_spinner_tasks_project_status_item">
                    </Spinner>
                </TableRow>

                <TableRow
                    android:id="@+id/tableRowWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewWallet"
                        style="@style/Tasks.Project.Popup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/Wallet"
                        android:textAlignment="textEnd" />

                    <Spinner
                        android:id="@+id/spinnerWallet"
                        style="@style/Tasks.Project.Popup.Spinner.Status"
                        android:layout_weight="1"
                        tools:listitem="@layout/simple_spinner_tasks_project_status_item">
                    </Spinner>
                </TableRow>

                <TableRow
                    android:id="@+id/tableRowCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewCategory"
                        style="@style/Tasks.Project.Popup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/CostCategory"
                        android:textAlignment="textEnd" />

                    <Spinner
                        android:id="@+id/spinnerCategory"
                        style="@style/Tasks.Project.Popup.Spinner.Status"
                        android:layout_weight="1"
                        tools:listitem="@layout/simple_spinner_tasks_project_status_item">
                    </Spinner>
                </TableRow>

                <TableRow
                    android:id="@+id/tableRowSubCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewSubCategory"
                        style="@style/Tasks.Project.Popup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/SubCategory"
                        android:textAlignment="textEnd" />

                    <Spinner
                        android:id="@+id/spinnerSubCategory"
                        style="@style/Tasks.Project.Popup.Spinner.Status"
                        android:layout_weight="1"
                        tools:listitem="@layout/simple_spinner_tasks_project_status_item">
                    </Spinner>
                </TableRow>

                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/textViewComment"
                        style="@style/Tasks.Project.Popup.TextView"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/editTextComment"
                        android:layout_gravity="center_vertical|end"
                        android:text="@string/Comment"
                        android:textAlignment="textEnd"
                        tools:ignore="RtlSymmetry" />

                    <EditText
                        android:id="@+id/editTextComment"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/Tasks.Project.Popup.EditText.Height2"
                        style="@style/Tasks.Project.Popup.EditText"
                        android:layout_weight="1"
                        android:minLines="1"
                        android:maxLines="3"
                        android:inputType="textMultiLine"
                        android:text="@string/CustomString2Lines"
                        android:textAlignment="textStart" />

                </TableRow>

            </TableLayout>

            <Button
                android:id="@+id/buttonSave"
                style="@style/Tasks.Project.Popup.Button.Save"
                android:layout_width="match_parent">

            </Button>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>