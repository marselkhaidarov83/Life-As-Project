<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Popup.LinearLayout.Main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaption"
        style="@style/Popup.ConstraintLayout.Caption">

        <ImageView
            android:id="@+id/imageViewDelete"
            style="@style/Popup.ImageView.Delete"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Popup.TextView.Caption"
            android:text="@string/PopupTaggedAdd"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/Popup.ImageView.Close"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewMascotToChange2"
            style="@style/Popup.ImageView.Mascot"
            app:layout_constraintEnd_toStartOf="@id/imageViewClose"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/Popup.TextView.ForSpinner"
                        android:text="@string/Tag" />

                    <Spinner
                        android:id="@+id/spinnerTag"
                        style="@style/Popup.Spinner"
                        tools:listitem="@layout/simple_spinner_1v_item"/>
                </TableRow>

            </TableLayout>

            <Button
                android:id="@+id/buttonSave"
                style="@style/Popup.Button.Save" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>