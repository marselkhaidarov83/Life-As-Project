<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaption"
        style="@style/MoneyCategoryPopup.LayoutCaption"
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <ImageView
            android:id="@+id/imageViewDelete"
            style="@style/MoneyCategoryPopup.ImageViewDelete"
            android:src="@drawable/icons8_delete_100_purple"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Popup.TextView.Caption"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/PopupPlanValueAdd"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/MoneyCategoryPopup.ImageViewClose"
            android:src="@drawable/icons8_close_window_100_purple"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical"
            android:orientation="vertical">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:paddingStart="@dimen/BasePadding2"
                android:paddingEnd="@dimen/BasePadding2"
                android:paddingTop="@dimen/BasePadding2"
                android:paddingBottom="@dimen/BasePadding">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewParam"
                        style="@style/ParamValuePopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/param"
                        android:textAlignment="textEnd" />

                    <Spinner
                        android:id="@+id/spinnerParam"
                        style="@style/ParamValuePopup.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:paddingTop="@dimen/BasePadding" />

                    <TextView
                        android:id="@+id/textViewMeasure"
                        style="@style/ParamValuePopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:paddingTop="-5dp"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/CustomShortString"
                        android:textAlignment="textEnd" />

                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/ParamValuePopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/spinnerType"
                        android:text="@string/Type"
                        android:textAlignment="textEnd" />

                    <Spinner
                        android:id="@+id/spinnerType"
                        style="@style/ParamValuePopup.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:paddingTop="@dimen/BasePadding" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewKoef"
                        style="@style/ParamValuePopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/editTextKoef"
                        android:text="@string/Koef"
                        android:textAlignment="textEnd" />

                    <EditText
                        android:id="@+id/editTextKoef"
                        style="@style/ParamValuePopup.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:paddingStart="7dp"
                        android:paddingTop="@dimen/BasePadding"
                        android:paddingEnd="0dp"
                        android:text="@string/CustomNum" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewParamSrc1"
                        style="@style/ParamValuePopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/source1"
                        android:textAlignment="textEnd" />

                    <Spinner
                        android:id="@+id/spinnerParamSrc1"
                        style="@style/ParamValuePopup.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:paddingTop="@dimen/BasePadding" />

                    <TextView
                        android:id="@+id/textViewMeasureSrc1"
                        style="@style/ParamValuePopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/CustomShortString"
                        android:textAlignment="textEnd" />

                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewParamSrc2"
                        style="@style/ParamValuePopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/source2"
                        android:textAlignment="textEnd" />

                    <Spinner
                        android:id="@+id/spinnerParamSrc2"
                        style="@style/ParamValuePopup.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:paddingTop="@dimen/BasePadding" />

                    <TextView
                        android:id="@+id/textViewMeasureSrc2"
                        style="@style/ParamValuePopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/CustomShortString"
                        android:textAlignment="textEnd" />

                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/textViewValue"
                        style="@style/ParamValuePopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/editTextValue"
                        android:text="@string/Value"
                        android:textAlignment="textEnd" />

                    <EditText
                        android:id="@+id/editTextValue"
                        style="@style/ParamValuePopup.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:paddingStart="7dp"
                        android:paddingTop="@dimen/BasePadding"
                        android:paddingEnd="0dp"
                        android:text="@string/CustomNum" />
                </TableRow>

            </TableLayout>

            <Button
                android:id="@+id/buttonSave"
                style="@style/MoneyCategoryPopup.ButtonSave"
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/BasePadding2"
                android:layout_marginEnd="@dimen/BasePadding2">

            </Button>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>