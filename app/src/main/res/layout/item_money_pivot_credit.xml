<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="40dp"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    android:layout_marginBottom="5dp">

    <LinearLayout
        android:id="@+id/linear_layout_item"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textViewStartSum"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="@dimen/Popup.TextSize02"
            android:layout_marginEnd="@dimen/BasePadding"
            android:paddingStart="@dimen/BasePadding"
            android:gravity="center_vertical|start"
            app:layout_constraintLeft_toRightOf="@id/textViewCostName"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/CustomString"/>

        <TextView
            android:id="@+id/textViewLoanTerm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="@dimen/Popup.TextSize02"
            android:layout_marginEnd="@dimen/BasePadding"
            android:gravity="center_vertical|center"
            app:layout_constraintLeft_toRightOf="@id/textViewSum"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/CustomString"/>

        <TextView
            android:id="@+id/textViewPercent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="@dimen/Popup.TextSize02"
            android:layout_marginEnd="@dimen/BasePadding"
            android:gravity="center_vertical|end"
            app:layout_constraintLeft_toRightOf="@id/textViewSum"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/CustomString"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>