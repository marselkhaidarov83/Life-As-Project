<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/materialCardViewBoard"
    style="@style/Board.MainLayout">

    <LinearLayout
        style="@style/Board.LinearLayout.Horizontal">

        <LinearLayout
            style="@style/Board.LinearLayout.Vertical"
            android:layout_weight="2">

            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/Board.ConstraintLayout">

                <TextView
                    android:id="@+id/textViewIntegers1Text"
                    style="@style/Board.TextView"
                    android:text="@string/TotalFunds"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/imageView1"
                    style="@style/Board.ImageView"
                    android:src="@drawable/icons_money_acc_100_purple"
                    app:layout_constraintStart_toEndOf="@id/textViewIntegers1Text"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/Board.ConstraintLayout.Next">

                <TextView
                    android:id="@+id/textViewIntegers2Text"
                    style="@style/Board.TextView"
                    android:text="@string/TotalOperPlan"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/imageView2"
                    style="@style/Board.ImageView"
                    android:src="@drawable/icons_icon_money_box_100"
                    app:layout_constraintStart_toEndOf="@id/textViewIntegers2Text"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/Board.ConstraintLayout.Next">

                <TextView
                    android:id="@+id/textViewIntegers3Text"
                    style="@style/Board.TextView"
                    android:text="@string/Difference"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/imageView3"
                    style="@style/Board.ImageView"
                    android:src="@drawable/icons_money_box_plus_100_purple"
                    app:layout_constraintStart_toEndOf="@id/textViewIntegers3Text"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <LinearLayout
            style="@style/Board.LinearLayout.Vertical"
            android:layout_weight="3">

            <ImageView
                style="@style/Board.ImageView.Subscription" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>