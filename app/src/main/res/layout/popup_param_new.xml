<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="600dp"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaption"
        style="@style/MoneyCategoryPopup.LayoutCaption"
        android:layout_width="match_parent">

        <ImageView
            android:id="@+id/imageViewDelete"
            style="@style/MoneyCategoryPopup.ImageViewDelete"
            android:src="@drawable/icons8_delete_100_purple"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/ParamPopup.TextViewCaption"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/PopupParamAdd"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/ParamPopup.ImageViewClose"
            android:src="@drawable/icons8_close_window_100_purple"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:orientation="vertical">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:padding="@dimen/BasePadding2">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewParent"
                        style="@style/ParamPopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/spinnerParent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/Name"
                        android:textAlignment="textEnd" />

                    <EditText
                        android:id="@+id/editTextName"
                        style="@style/ParamPopup.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:inputType="text"
                        android:maxLength="40"
                        android:paddingStart="7dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="0dp"
                        android:text="@string/CustomString" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/ParamPopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/editTextMeasure"
                        android:text="@string/Measure"
                        android:textAlignment="textEnd" />

                    <EditText
                        android:id="@+id/editTextMeasure"
                        style="@style/ParamPopup.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:maxLength="10"
                        android:inputType="text"
                        android:paddingStart="7dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="0dp"
                        android:text="@string/CustomString" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/ParamPopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/editTextComment"
                        android:text="@string/Comment"
                        android:textAlignment="textEnd" />

                    <EditText
                        android:id="@+id/editTextComment"
                        style="@style/ParamPopup.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:minLines="1"
                        android:maxLines="2"
                        android:inputType="textMultiLine"
                        android:paddingStart="7dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="0dp"
                        android:text="@string/CustomString" />
                </TableRow>

            </TableLayout>

            <Button
                android:id="@+id/buttonSave"
                style="@style/ParamPopup.ButtonSave"
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/BasePadding2"
                android:layout_marginEnd="@dimen/BasePadding2">

            </Button>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>