<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linearLayoutDate"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingBottom="@dimen/HalfPadding">

        <ImageView
            android:id="@+id/imageViewDateBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:textAlignment="textEnd"
            android:src="@drawable/icons_double_left_48" />

        <Spinner
            android:id="@+id/spinnerDate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:textAlignment="center"
            android:layout_weight="10" />

        <ImageView
            android:id="@+id/imageViewDateForward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:textAlignment="textStart"
            android:src="@drawable/icons_double_right_48" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleViewTasks"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/item_tasks_task">
    </androidx.recyclerview.widget.RecyclerView>

</LinearLayout>