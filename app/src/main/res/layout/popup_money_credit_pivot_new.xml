<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCaption"
        style="@style/MoneyCategoryPopup.LayoutCaption"
        android:layout_width="match_parent">

        <ImageView
            android:id="@+id/imageViewDelete"
            style="@style/MoneyCategoryPopup.ImageViewDelete"
            android:src="@drawable/icons8_delete_100_purple"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Popup.TextView.Caption"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/PopupCreditPivotAdd"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/MoneyCategoryPopup.ImageViewClose"
            android:src="@drawable/icons8_close_window_100_purple"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="@dimen/BasePadding"
            android:orientation="vertical">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/BasePadding">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewStartSum"
                        style="@style/MoneyCategoryPopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/editTextStartSum"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/Sum"
                        android:textAlignment="textEnd" />

                    <EditText
                        android:id="@+id/editTextStartSum"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        style="@style/MoneyCategoryPopup.EditText"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="@string/CustomString"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewLoanTerm"
                        style="@style/MoneyCategoryPopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/editTextLoanTerm"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/LoanTerm"
                        android:textAlignment="textEnd" />

                    <EditText
                        android:id="@+id/editTextLoanTerm"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        style="@style/MoneyCategoryPopup.EditText"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:text="@string/CustomString"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/BasePadding">

                    <TextView
                        android:id="@+id/textViewPercent"
                        style="@style/MoneyCategoryPopup.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/BasePadding"
                        android:labelFor="@id/editTextPercent"
                        android:paddingBottom="@dimen/BasePadding"
                        android:text="@string/CreditPercent"
                        android:textAlignment="textEnd" />

                    <EditText
                        android:id="@+id/editTextPercent"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        style="@style/MoneyCategoryPopup.EditText"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:text="@string/CustomString"
                        android:textAlignment="center"
                        android:textStyle="bold" />

                </TableRow>

            </TableLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/BasePadding">

                <Button
                    android:id="@+id/buttonSave"
                    style="@style/MoneyCategoryPopup.ButtonSave"
                    android:layout_width="match_parent"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>