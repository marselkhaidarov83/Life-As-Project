<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Popup.Settings.LinearLayout.TopHead">

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/Popup.Settings.ConstraintLayout.Head">

        <TextView
            android:id="@+id/textViewCaption"
            style="@style/Popup.Settings.TextView.Caption"
            android:text="@string/SettingsMoneyIncrease"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageViewClose"
            style="@style/Popup.Settings.ImageView.Close"
            android:contentDescription="@string/ButtonCloseWindow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        style="@style/Popup.Settings.NestedScrollView.Main">

        <LinearLayout
            style="@style/Popup.Settings.LinearLayout.Main">

            <CheckBox
                android:id="@+id/checkBoxShowArchive"
                style="@style/Popup.Settings.CheckBox"
                android:text="@string/IncreaseSettingsShowArchive"/>

            <Button
                android:id="@+id/buttonSave"
                style="@style/Popup.Settings.Button.OK" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>